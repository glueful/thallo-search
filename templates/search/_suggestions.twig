{# The suggestion list and the status line for one search form (`key`). Inside the form for the
   field display and the /search page, where they open under it; after the field in the icon's
   panel, so they run across the panel under it rather than joining the field's row. #}
<ul id="thallo-search-list-{{ key }}" role="listbox" class="thallo-search-form__list" aria-label="Suggestions" hidden></ul>
<p class="thallo-search-form__status" role="status" aria-live="polite" data-search-status></p>
