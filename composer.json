{
  "name": "glueful/thallo-search",
  "description": "Search for Thallo: a public, delivery-parity content search API over Postgres full-text search or Meilisearch, as a removable capability pack.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Michael Tawiah Sowah",
      "email": "michael@glueful.dev"
    }
  ],
  "require": {
    "php": "^8.3",
    "glueful/thallo-contracts": "self.version",
    "glueful/extension-contracts": "*",
    "glueful/framework": "^1.65.0",
    "glueful/meilisearch": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Thallo\\Search\\": "src/"
    }
  },
  "extra": {
    "glueful": {
      "provider": "Thallo\\Search\\SearchServiceProvider",
      "requires": {
        "glueful": ">=1.79.0",
        "extensions": []
      },
      "migrations": [
        {
          "id": "default",
          "path": "migrations",
          "priority": "dependent",
          "mode": "core",
          "verifier": "Thallo\\Search\\Schema\\SearchSchemaVerifier"
        }
      ]
    }
  },
  "minimum-stability": "stable"
}
